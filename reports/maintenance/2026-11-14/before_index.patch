-double smooth01(double w)
-{
-  w = std::clamp(w, 0.0, 1.0);
-  return w * w * (3.0 - 2.0 * w);
-}
-
-double dsmooth01(double w)
-{
-  return (w <= 0.0 || w >= 1.0) ? 0.0 : 6.0 * w * (1.0 - w);
-}
