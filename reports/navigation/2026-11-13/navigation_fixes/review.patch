+  tr.setPath(polyline({{1.2, 0}, {2., 0}}));
+  EXPECT_DOUBLE_EQ(tr.compute({1.2, 0, 0}).weight, 0.0);
+  tr.setPath(polyline({{.4, 0}, {.4, 1.5}}));
+  EXPECT_DOUBLE_EQ(tr.compute({.4, 0, 0}).weight, 0.0);
+}
