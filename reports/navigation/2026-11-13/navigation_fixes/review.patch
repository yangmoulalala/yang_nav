+    cmd.twist.linear.x = speed * (cy * dx + sy * dy) / std::max(distance, 1e-6);
+    cmd.twist.linear.y = speed * (-sy * dx + cy * dy) / std::max(distance, 1e-6);
+    return cmd;
+  }
