Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
      Cell Size: 1
      Plane Cell Count: 40
      Color: 90; 90; 90
    - Class: rviz_default_plugins/Map
      Name: Nav map (offline traversability)
      Enabled: true
      Alpha: 0.7
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /nav_map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Map
      Name: Global costmap
      Enabled: true
      Alpha: 0.4
      Color Scheme: costmap
      Topic:
        Value: /global_costmap/costmap
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Map
      Name: Local costmap
      Enabled: true
      Alpha: 0.6
      Color Scheme: costmap
      Topic:
        Value: /local_costmap/costmap
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: false
      Alpha: 1
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Color: 255; 255; 0
      Topic:
        Value: /local_costmap/published_footprint
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Path
      Name: Global plan
      Enabled: true
      Color: 0; 255; 0
      Line Style: Billboards
      Line Width: 0.04
      Topic:
        Value: /plan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/PointCloud2
      Name: Terrain obstacles
      Enabled: true
      Color Transformer: FlatColor
      Color: 255; 0; 0
      Size (m): 0.05
      Style: Flat Squares
      Decay Time: 0
      Topic:
        Value: /terrain_analysis/obstacles
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
    - Class: rviz_default_plugins/PointCloud2
      Name: Terrain clearing (ground + known roofs)
      Enabled: false
      Color Transformer: FlatColor
      Color: 0; 200; 255
      Size (m): 0.02
      Style: Flat Squares
      Topic:
        Value: /terrain_analysis/clearing
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
    - Class: rviz_default_plugins/PointCloud2
      Name: Live cloud (map)
      Enabled: false
      Color Transformer: AxisColor
      Axis: Z
      Size (m): 0.02
      Style: Flat Squares
      Topic:
        Value: /localization/lio_world_cloud
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
    - Class: rviz_default_plugins/Pose
      Name: Goal
      Enabled: true
      Color: 255; 0; 255
      Shape: Arrow
      Topic:
        Value: /goal_pose
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
  Enabled: true
  Global Options:
    Background Color: 40; 40; 40
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Value: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Angle: 0
      Scale: 45
      X: 6
      Y: -2.5
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 1000
  Width: 1600
