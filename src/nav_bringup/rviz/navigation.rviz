Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
    Tree Height: 520
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
      Cell Size: 1
      Plane Cell Count: 40
      Color: 90; 90; 90
    - Class: rviz_default_plugins/Map
      Name: Nav map (offline traversability)
      Enabled: true
      Alpha: 0.7
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /nav_map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Map
      Name: Global costmap
      Enabled: false
      Alpha: 0.4
      Color Scheme: costmap
      Topic:
        Value: /global_costmap/costmap
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Map
      Name: Local costmap
      Enabled: true
      Alpha: 0.5
      Color Scheme: costmap
      Topic:
        Value: /local_costmap/costmap
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/MarkerArray
      Name: Tunnel zones (body / axis / id)
      Enabled: true
      Topic:
        Value: /nav_zones/markers
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: true
      Alpha: 0.6
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Polygon
      Name: Footprint (padded, costmap)
      Enabled: true
      Color: 255; 255; 0
      Topic:
        Value: /local_costmap/published_footprint
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Path
      Name: Shaped path (FollowPath input)
      Enabled: true
      Color: 0; 255; 0
      Line Style: Lines
      Line Width: 0.03
      Pose Style: Arrows
      Head Length: 0.04
      Head Diameter: 0.04
      Shaft Length: 0.08
      Shaft Diameter: 0.015
      Topic:
        Value: /plan_smoothed
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Path
      Name: Planner path (Smac, before shaping)
      Enabled: false
      Color: 120; 120; 255
      Line Style: Lines
      Line Width: 0.02
      Topic:
        Value: /plan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/Path
      Name: MPPI path window (transformed_global_plan)
      Enabled: false
      Color: 255; 0; 255
      Line Style: Lines
      Line Width: 0.02
      Topic:
        Value: /transformed_global_plan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/MarkerArray
      Name: Tracker state (phase / errors / heading ref)
      Enabled: true
      Topic:
        Value: /nav_zones/tracker
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Frames:
        All Enabled: false
        map:
          Value: true
        lio_odom:
          Value: true
        base_link:
          Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Live cloud (map)
      Enabled: false
      Color Transformer: AxisColor
      Axis: Z
      Size (m): 0.02
      Style: Flat Squares
      Decay Time: 0
      Topic:
        Value: /localization/lio_world_cloud
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        History Policy: Keep Last
    - Class: rviz_default_plugins/Pose
      Name: Goal
      Enabled: true
      Color: 255; 0; 255
      Shape: Arrow
      Shaft Length: 0.4
      Topic:
        Value: /goal_pose
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
  Enabled: true
  Global Options:
    Background Color: 40; 40; 40
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
    - Class: nav2_rviz_plugins/GoalTool
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Value: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Angle: 0
      Scale: 45
      X: 6
      Y: -2.5
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 1000
  Width: 1600
